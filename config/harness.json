{
  "defaultMode": "build",
  "cycle": [
    "brainstorm",
    "plan",
    "build"
  ],
  "cycleShortcuts": [
    "ctrl+alt+m",
    "f6"
  ],
  "modes": {
    "brainstorm": {
      "label": "brainstorm",
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "thinkingLevel": "max",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "ocr_image",
        "deepseek_delegate"
      ],
      "instructionsFile": "../instructions/brainstorm.md"
    },
    "plan": {
      "label": "plan",
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "thinkingLevel": "max",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "ocr_image",
        "deepseek_delegate",
        "plan_interview"
      ],
      "instructionsFile": "../instructions/plan.md"
    },
    "build": {
      "label": "build",
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "thinkingLevel": "high",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "bash",
        "edit",
        "write",
        "ocr_image",
        "deepseek_delegate"
      ],
      "instructionsFile": "../instructions/build.md"
    }
  }
}
