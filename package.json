{
  "name": "pi-deepseek-harness-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A cache-conscious DeepSeek-native mode harness for Pi",
  "keywords": [
    "pi-package",
    "deepseek",
    "coding-agent"
  ],
  "scripts": {
    "check": "node ./scripts/check-config.mjs && node --experimental-strip-types ./scripts/check-sensitive.mjs && node --experimental-strip-types ./scripts/check-ferrari-workflow.mjs"
  },
  "dependencies": {
    "tesseract.js": "7.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/sensitive-paths.ts",
      "./extensions/deepseek-subagents.ts",
      "./extensions/deepseek-modes.ts",
      "./extensions/plan-interview.ts",
      "./extensions/deepseek-context.ts",
      "./extensions/deepseek-efficiency.ts",
      "./extensions/deepseek-search.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
